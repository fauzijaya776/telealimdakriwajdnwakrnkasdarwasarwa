# Tambahkan ke Environment hosting bot ALIM (Render / VPS). JANGAN commit nilai asli.

# Gateway QRIS untuk order BARU: autogopay | pakasir
# (kosong -> autogopay kalau AUTOGOPAY_API_KEY diisi). Order lama tetap dicek ke gateway pembuatnya.
PAYMENT_PROVIDER=autogopay
AUTOGOPAY_API_KEY=

# Anti-blokir QRIS (hapus baris untuk memakai nilai bawaan)
# PAYMENT_ENABLED=0         # kill switch: tutup pembayaran QRIS baru
QRIS_MAX_PER_DAY=8          # tagihan QRIS per pembeli per 24 jam
QRIS_MAX_UNPAID=5           # tagihan tak dibayar berturut-turut -> dikunci (maks 24 jam)
QRIS_COOLDOWN_MIN=3         # jeda (menit) antar tagihan, kecuali yang terakhir lunas
QRIS_GLOBAL_PER_MIN=30      # rem darurat: maks tagihan seluruh bot per menit

# Env Pakasir (PAKASIR_PROJECT, PAKASIR_API_KEY, ...) JANGAN dihapus: order Pakasir lama
# masih dicek ke Pakasir, dan bisa pindah balik dengan PAYMENT_PROVIDER=pakasir.
