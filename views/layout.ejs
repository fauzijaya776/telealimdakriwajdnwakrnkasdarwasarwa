<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Panel - <%= page.charAt(0).toUpperCase() + page.slice(1) %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8f9fa;
        }
        .sidebar a:hover { background-color: #f3f4f6; }
        .active-link {
            background-color: #f5f3ff;
            color: #6d28d9;
            font-weight: 600;
        }
        .active-link .icon { color: #6d28d9; }
    </style>
</head>
<body class="bg-gray-100">
    <div class="flex h-screen">
        <aside class="w-64 bg-white flex flex-col shadow-lg">
            <div class="h-16 flex items-center justify-center border-b">
                 <div class="flex items-center">
                    <svg class="h-8 w-8 text-purple-700" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6h9.75M10.5 6a1.5 1.5 0 11-3 0m3 0a1.5 1.5 0 10-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m-3.75 0H7.5m9-6h3.75m-3.75 0a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m-9.75 0h9.75" /></svg>
                    <h1 class="text-xl font-bold text-gray-800 ml-2">Admin Panel</h1>
                 </div>
            </div>
            <nav class="flex-1 px-4 py-4 space-y-2">
                <a href="/" class="flex items-center px-4 py-2.5 text-gray-600 rounded-md <%= page === 'dashboard' ? 'active-link' : '' %>">
                    <svg class="w-5 h-5 mr-3 icon" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" /></svg> Dashboard
                </a>
                <a href="/users" class="flex items-center px-4 py-2.5 text-gray-600 rounded-md <%= page === 'users' ? 'active-link' : '' %>">
                     <svg class="w-5 h-5 mr-3 icon" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M15 21a6 6 0 00-9-5.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-3-5.197M15 21a2.25 2.25 0 00-2.25-2.25H10.5A2.25 2.25 0 008.25 21M15 21a2.25 2.25 0 002.25-2.25h-4.5A2.25 2.25 0 0015 21z" /></svg> Users
                </a>
                <a href="/products" class="flex items-center px-4 py-2.5 text-gray-600 rounded-md <%= page === 'products' ? 'active-link' : '' %>">
                     <svg class="w-5 h-5 mr-3 icon" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" /></svg> Products
                </a>
                <a href="/broadcast" class="flex items-center px-4 py-2.5 text-gray-600 rounded-md <%= page === 'broadcast' ? 'active-link' : '' %>">
                   <svg class="w-5 h-5 mr-3 icon" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-2.236 9.168-5.584M13 18l5-5m0 0l-5-5m5 5H6" /></svg> Broadcast
                </a>
                <a href="/assets" class="flex items-center px-4 py-2.5 text-gray-600 rounded-md <%= page === 'assets' ? 'active-link' : '' %>">
                <svg class="w-5 h-5 mr-3 icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg> Assets
                </a>
                    <a href="/payment-gateways" class="flex items-center px-4 py-2.5 text-gray-600 rounded-md <%= page === 'payment-gateways' ? 'active-link' : '' %>">
                    <svg class="w-5 h-5 mr-3 icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" /></svg> Payment Gateway
                </a>
                <a href="/api-docs" class="flex items-center px-4 py-2.5 text-gray-600 rounded-md <%= page === 'api-docs' ? 'active-link' : '' %>">
                    <svg class="w-5 h-5 mr-3 icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" /></svg> API DOC
                </a>
                <a href="/pembeli-do" class="flex items-center px-4 py-2.5 text-gray-600 rounded-md <%= page === 'pembeli-do' ? 'active-link' : '' %>">
                    <svg class="w-5 h-5 mr-3 icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" /></svg> Pembeli DO
                </a>
            </nav>
            </nav>
            <div class="p-4 mt-auto border-t">
                <a href="/logout" class="flex items-center px-4 py-2.5 text-gray-600 rounded-md">
                    <svg class="w-5 h-5 mr-3 icon" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15m3 0l3-3m0 0l-3-3m3 3H9" /></svg> Logout
                </a>
            </div>
        </aside>

        <div class="flex-1 flex flex-col">
            <header class="h-16 bg-white border-b flex items-center justify-between px-8">
                <h1 class="text-xl font-bold text-gray-800 capitalize"><%= page %></h1>
                 <a href="/logout" class="bg-red-500 hover:bg-red-600 text-white font-bold py-2 px-4 rounded-lg text-sm">
                    Logout
                </a>
            </header>
            <main class="flex-1 p-8 overflow-y-auto">
                <%- body %>
            </main>
        </div>
    </div>
</body>
</html>